{
  "name": "sinfo-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP de composicion musical: forma, armonia, contrapunto y orquestacion para agentes de IA",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "arch": "depcruise \"packages/*/src/**/*.ts\" --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run test && npm run arch"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.10.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
